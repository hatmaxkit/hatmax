#!/usr/bin/env bash

set -euo pipefail

STAGED_GO_FILES="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.go$' || true)"

if [ -z "$STAGED_GO_FILES" ]; then
  exit 0
fi

echo "Formatting staged Go files..."
echo "$STAGED_GO_FILES" | xargs gofmt -w
echo "$STAGED_GO_FILES" | xargs git add

LINT_CACHE_DIR="$(pwd)/.tmp/lint"
LINT_GOCACHE="$LINT_CACHE_DIR/gocache"
mkdir -p "$LINT_GOCACHE"

echo "Running staged lint checks..."
STAGED_DIRS="$(echo "$STAGED_GO_FILES" | xargs -n1 dirname | sort -u | tr '\n' ' ')"
GOCACHE="$LINT_GOCACHE" golangci-lint run --default=none --enable=nlreturn --enable=noinlineerr --enable=wsl_v5 $STAGED_DIRS
